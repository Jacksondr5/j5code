---
/**
 * One of the peering page's three scenes: a cloud VM on the left and a second
 * device on the right, with two agents on each. Boats are agents and dots are
 * messages, flying flag to flag as on the homepage's A2A scene.
 *
 * - direct: both devices can reach each other; asks and replies go straight
 *   across, 8s loop.
 * - firewall: the laptop can't be reached, so asks for it wait on the VM's
 *   pier and the flagless barge (J5 polling) fetches each one and hands it to
 *   its agent. Replies go directly. 14s loop.
 * - asleep: the laptop sleeps while three asks wait, then wakes and the barge
 *   fetches them all in order. 16s loop.
 *
 * Gated by the motion controller through --motion-state. Under reduced motion
 * each scene holds one still: the firewall scene an ask waiting with the barge
 * at home, the asleep scene the laptop asleep with three asks waiting.
 */
interface Props {
  variant: "direct" | "firewall" | "asleep";
}

const { variant } = Astro.props;

const copy = {
  direct: {
    label: "Agents on two devices messaging each other directly",
    right: "LOCAL SERVER",
    leftSub: "always on",
    rightSub: "always on",
  },
  firewall: {
    label: "A laptop behind a firewall polls a VM for its messages; replies go directly",
    right: "WORK LAPTOP",
    leftSub: "always on, reachable",
    rightSub: "behind an office firewall",
  },
  asleep: {
    label: "Messages wait on the VM while the laptop sleeps, then the laptop fetches them on waking",
    right: "LAPTOP",
    leftSub: "always on",
    rightSub: null,
  },
}[variant];

const water = "M0 158 Q 40 152 80 158 T 160 158 T 240 158 T 320 158 T 400 158 T 480 158 T 560 158 T 640 158 T 720 158 T 800 158";
const lowWater = "M0 218 Q 40 212 80 218 T 160 218 T 240 218 T 320 218 T 400 218 T 480 218 T 560 218 T 640 218 T 720 218 T 800 218";
const prefix = { direct: "s1", firewall: "s2", asleep: "s3" }[variant];
// Asleep's second boat on each side neither sends nor receives, so its flag holds.
const still = variant === "asleep";
---

<svg class:list={["scene", prefix]} viewBox="0 -24 800 264" role="img" aria-label={copy.label} data-motion>
  <rect class="region" x="8" y="8" width="384" height="226" rx="14" />
  <rect class="region" x="408" y="8" width="384" height="226" rx="14" />
  <text class="lbl" x="24" y="32">CLOUD VM</text><text class="lbl-sub" x="24" y="50">{copy.leftSub}</text>
  <text class="lbl" x="424" y="32">{copy.right}</text>
  {copy.rightSub && <text class="lbl-sub" x="424" y="50">{copy.rightSub}</text>}
  {variant === "asleep" && <text class="lbl-sub anim s3-awake" x="424" y="50">awake</text>}

  {
    variant === "firewall" ? (
      <>
        <line class="firewall" x1="400" y1="40" x2="400" y2="232" />
        <text class="firewall-lbl" x="400" y="-8" text-anchor="middle">FIREWALL · NO INCOMING CONNECTIONS</text>
      </>
    ) : (
      <>
        <line class="divider" x1="400" y1="40" x2="400" y2="232" />
        <text class="divider-lbl" x="400" y="-8" text-anchor="middle">NETWORK</text>
      </>
    )
  }
  <path class="water" d={water} />

  {
    variant !== "direct" && (
      <>
        <path class="water" d={lowWater} />
        <line class="pier-pile" x1="206" y1="203" x2="206" y2="224" />
        <line class="pier-pile" x1="268" y1="203" x2="268" y2="224" />
        <rect class="pier-plank" x="200" y="199" width="74" height="5" rx="1" />
        <text class="lbl-sub pier-lbl" x="190" y="212" text-anchor="end">waiting on the VM</text>
      </>
    )
  }

  <g transform="translate(30 110) scale(1.1)"><g class="bob b1"><use class:list={["agent anim", `${prefix}-fS1`]} href="#j5-boat" /></g></g>
  <g transform="translate(140 110) scale(1.1)"><g class="bob b2"><use class:list={["agent", !still && "anim", `${prefix}-fS2`]} href="#j5-boat" /></g></g>
  <g transform="translate(560 110) scale(1.1)"><g class="bob b3"><use class:list={["agent anim", `${prefix}-fL1`]} href="#j5-boat" /></g></g>
  <g transform="translate(670 110) scale(1.1)"><g class="bob b4"><use class:list={["agent", !still && "anim", `${prefix}-fL2`]} href="#j5-boat" /></g></g>

  {
    variant === "direct" && (
      <>
        <circle class="dot ask s1-h1" r="4.5" />
        <circle class="dot reply s1-h2" r="4.5" />
        <circle class="dot ask s1-h3" r="4.5" />
        <circle class="dot reply s1-h4" r="4.5" />
      </>
    )
  }

  {
    variant === "firewall" && (
      <>
        <circle class="held ask s2-p1" cx="214" cy="194.5" r="4.5" />
        <circle class="held ask s2-p2" cx="214" cy="194.5" r="4.5" />
        <g transform="translate(600 190)">
          <g class="anim s2-barge">
            <g class="bob barge-bob">
              <use href="#j5-barge" />
              <circle class="held ask s2-c1" cx="20" cy="4.5" r="4.5" />
              <circle class="held ask s2-c2" cx="20" cy="4.5" r="4.5" />
            </g>
          </g>
        </g>
        <circle class="dot ask s2-d1" r="4.5" />
        <circle class="dot ask s2-l1" r="4.5" />
        <circle class="dot ask s2-u1" r="4.5" />
        <circle class="dot reply s2-r1" r="4.5" />
        <circle class="dot ask s2-d2" r="4.5" />
        <circle class="dot ask s2-l2" r="4.5" />
        <circle class="dot ask s2-u2" r="4.5" />
        <circle class="dot reply s2-r2" r="4.5" />
      </>
    )
  }

  {
    variant === "asleep" && (
      <>
        <circle class="held ask s3-p1" cx="214" cy="194.5" r="4.5" />
        <circle class="held ask s3-p2" cx="232" cy="194.5" r="4.5" />
        <circle class="held ask s3-p3" cx="250" cy="194.5" r="4.5" />
        <g transform="translate(600 190)">
          <g class="anim s3-barge">
            <g class="bob barge-bob">
              <use href="#j5-barge" />
              <circle class="held ask s3-c1" cx="20" cy="4.5" r="4.5" />
              <circle class="held ask s3-c2" cx="32" cy="4.5" r="4.5" />
              <circle class="held ask s3-c3" cx="44" cy="4.5" r="4.5" />
            </g>
          </g>
        </g>
        {/* Night falls over the whole laptop, agents and poller alike. */}
        <g class="anim s3-night">
          <rect x="408" y="8" width="384" height="226" rx="14" fill="#0a1c30" fill-opacity="0.62" />
          <path d="M770 22 a12 12 0 1 0 9 20 a9.5 9.5 0 1 1 -9 -20z" fill="#dfe9ee" />
          <text class="lbl night-lbl" x="752" y="36" text-anchor="end">ASLEEP</text>
        </g>
        <circle class="dot ask s3-s1" r="4.5" />
        <circle class="dot ask s3-s2" r="4.5" />
        <circle class="dot ask s3-s3" r="4.5" />
        <circle class="dot ask s3-l1" r="4.5" />
        <circle class="dot ask s3-l2" r="4.5" />
        <circle class="dot ask s3-l3" r="4.5" />
        <circle class="dot ask s3-u1" r="4.5" />
        <circle class="dot ask s3-u2" r="4.5" />
        <circle class="dot ask s3-u3" r="4.5" />
        <circle class="dot reply s3-r1" r="4.5" />
      </>
    )
  }
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Boat colors for chart paper, as Boat.astro's light tone. */
  .agent {
    --ink: #12202f;
    --hull: #fbf7ee;
    --sail-l: #e5ddc8;
    --sail-r: #fbf7ee;
    --pennant: var(--msg-reply);
    --pennant-fill: var(--pennant);
  }

  .b1 { --bob-dur: 5.2s; --bob-delay: -1s; }
  .b2 { --bob-dur: 5.6s; --bob-delay: -2.4s; }
  .b3 { --bob-dur: 5.8s; --bob-delay: -3s; }
  .b4 { --bob-dur: 5.4s; --bob-delay: -0.4s; }
  .barge-bob { --bob-dur: 6.4s; --bob-delay: -1.7s; }

  .region { fill: var(--canvas-2); fill-opacity: 0.55; stroke: var(--canvas-line); }
  .lbl { font: 600 11px var(--font-mono); letter-spacing: 0.08em; fill: var(--ink); }
  .lbl-sub { font: 400 12px var(--font-sans); fill: var(--ink-dim); }
  .night-lbl { fill: var(--foam); }
  .water { fill: none; stroke: var(--sea); stroke-opacity: 0.45; stroke-width: 1.2; }
  .divider { stroke: var(--ink-dim); stroke-opacity: 0.4; stroke-width: 1.2; stroke-dasharray: 2 6; }
  .divider-lbl { font: 500 10.5px var(--font-mono); letter-spacing: 0.08em; fill: var(--ink-dim); }
  .firewall { stroke: var(--signal); stroke-width: 2.4; stroke-dasharray: 1 6; stroke-linecap: round; }
  .firewall-lbl { font: 600 10.5px var(--font-mono); letter-spacing: 0.08em; fill: var(--signal); }
  .pier-plank { fill: var(--brass-deep); stroke: var(--ink); stroke-width: 1.2; }
  .pier-pile { stroke: var(--ink); stroke-width: 2.2; }

  /* On a phone the scene scales to about 40%, so the labels grow to stay legible. */
  @media (max-width: 600px) {
    .lbl, .lbl-sub, .divider-lbl, .firewall-lbl { font-size: 18px; }
    .lbl-sub:not(.pier-lbl) { transform: translateY(10px); }
  }

  .dot, .held { opacity: 0; }
  .dot { offset-rotate: 0deg; }
  .dot, .held, .anim {
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .ask { fill: var(--msg-ask); }
  .reply { fill: var(--msg-reply); }

  /* Direct, 8s. S1 asks L1, L1 replies; L2 asks S2, S2 replies. */
  .s1 .dot, .s1 .anim { animation-duration: 8s; }
  .s1-h1 { offset-path: path("M65 108 Q 330 -30 595 108"); animation-name: s1-h1; }
  .s1-h2 { offset-path: path("M595 108 Q 330 -30 65 108"); animation-name: s1-h2; }
  .s1-h3 { offset-path: path("M705 108 Q 440 -30 175 108"); animation-name: s1-h3; }
  .s1-h4 { offset-path: path("M175 108 Q 440 -30 705 108"); animation-name: s1-h4; }
  @keyframes s1-h1 { 0%, 4% { offset-distance: 0%; opacity: 0; } 5% { opacity: 1; } 13% { opacity: 1; } 14%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s1-h2 { 0%, 20% { offset-distance: 0%; opacity: 0; } 21% { opacity: 1; } 29% { opacity: 1; } 30%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s1-h3 { 0%, 50% { offset-distance: 0%; opacity: 0; } 51% { opacity: 1; } 59% { opacity: 1; } 60%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s1-h4 { 0%, 66% { offset-distance: 0%; opacity: 0; } 67% { opacity: 1; } 75% { opacity: 1; } 76%, 100% { offset-distance: 100%; opacity: 0; } }
  .s1-fS1 { --pennant: var(--msg-receive); animation-name: s1-fS1; }
  .s1-fL1 { --pennant: var(--msg-reply); animation-name: s1-fL1; }
  .s1-fS2 { --pennant: var(--msg-reply); animation-name: s1-fS2; }
  .s1-fL2 { --pennant: var(--msg-receive); animation-name: s1-fL2; }
  @keyframes s1-fS1 { 0%, 3.5% { --pennant: var(--msg-receive); } 4.5%, 29.5% { --pennant: var(--msg-ask); } 30.5%, 100% { --pennant: var(--msg-receive); } }
  @keyframes s1-fL1 { 0%, 13.5% { --pennant: var(--msg-reply); } 14.5%, 19.5% { --pennant: var(--msg-receive); } 20.5%, 100% { --pennant: var(--msg-reply); } }
  @keyframes s1-fL2 { 0%, 49.5% { --pennant: var(--msg-receive); } 50.5%, 75.5% { --pennant: var(--msg-ask); } 76.5%, 100% { --pennant: var(--msg-receive); } }
  @keyframes s1-fS2 { 0%, 59.5% { --pennant: var(--msg-reply); } 60.5%, 65.5% { --pennant: var(--msg-receive); } 66.5%, 100% { --pennant: var(--msg-reply); } }

  /* Firewall, 14s. The barge stays home on the laptop and sets out only when an
     ask waits on the VM's pier: it crosses, loads it, comes back, and hands it
     to its agent. Replies go directly. */
  .s2 .dot, .s2 .held, .s2 .anim { animation-duration: 14s; }
  .s2-barge { animation-name: s2-barge; }
  @keyframes s2-barge {
    0%, 9% { transform: translateX(0); } 21%, 24% { transform: translateX(-322px); }
    36%, 52% { transform: translateX(0); } 64%, 67% { transform: translateX(-322px); }
    79%, 100% { transform: translateX(0); }
  }
  .s2-p1 { opacity: 1; animation-name: s2-p1; }
  .s2-p2 { animation-name: s2-p2; }
  .s2-c1 { animation-name: s2-c1; }
  .s2-c2 { animation-name: s2-c2; }
  @keyframes s2-p1 { 0%, 7.9% { opacity: 0; } 8%, 20.9% { opacity: 1; } 21%, 100% { opacity: 0; } }
  @keyframes s2-p2 { 0%, 50.9% { opacity: 0; } 51%, 63.9% { opacity: 1; } 64%, 100% { opacity: 0; } }
  @keyframes s2-c1 { 0%, 23.9% { opacity: 0; } 24%, 36.9% { opacity: 1; } 37%, 100% { opacity: 0; } }
  @keyframes s2-c2 { 0%, 66.9% { opacity: 0; } 67%, 79.9% { opacity: 1; } 80%, 100% { opacity: 0; } }
  .s2-d1 { offset-path: path("M65 108 Q 140 50 214 194.5"); animation-name: s2-d1; }
  .s2-l1 { offset-path: path("M214 194.5 Q 256 160 298 194.5"); animation-name: s2-l1; }
  .s2-u1 { offset-path: path("M620 194.5 Q 630 140 595 108"); animation-name: s2-u1; }
  .s2-r1 { offset-path: path("M595 108 Q 330 -30 65 108"); animation-name: s2-r1; }
  .s2-d2 { offset-path: path("M175 108 Q 210 70 214 194.5"); animation-name: s2-d2; }
  .s2-l2 { offset-path: path("M214 194.5 Q 256 160 298 194.5"); animation-name: s2-l2; }
  .s2-u2 { offset-path: path("M620 194.5 Q 690 170 705 108"); animation-name: s2-u2; }
  .s2-r2 { offset-path: path("M705 108 Q 440 -30 175 108"); animation-name: s2-r2; }
  @keyframes s2-d1 { 0%, 3% { offset-distance: 0%; opacity: 0; } 3.5% { opacity: 1; } 7.5% { opacity: 1; } 8%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-l1 { 0%, 21% { offset-distance: 0%; opacity: 0; } 21.3% { opacity: 1; } 23.7% { opacity: 1; } 24%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-u1 { 0%, 37% { offset-distance: 0%; opacity: 0; } 37.5% { opacity: 1; } 39.5% { opacity: 1; } 40%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-r1 { 0%, 43% { offset-distance: 0%; opacity: 0; } 43.5% { opacity: 1; } 48.5% { opacity: 1; } 49%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-d2 { 0%, 46% { offset-distance: 0%; opacity: 0; } 46.5% { opacity: 1; } 50.5% { opacity: 1; } 51%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-l2 { 0%, 64% { offset-distance: 0%; opacity: 0; } 64.3% { opacity: 1; } 66.7% { opacity: 1; } 67%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-u2 { 0%, 80% { offset-distance: 0%; opacity: 0; } 80.5% { opacity: 1; } 82.5% { opacity: 1; } 83%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s2-r2 { 0%, 86% { offset-distance: 0%; opacity: 0; } 86.5% { opacity: 1; } 91.5% { opacity: 1; } 92%, 100% { offset-distance: 100%; opacity: 0; } }
  .s2-fS1 { --pennant: var(--msg-receive); animation-name: s2-fS1; }
  .s2-fL1 { --pennant: var(--msg-reply); animation-name: s2-fL1; }
  .s2-fS2 { --pennant: var(--msg-receive); animation-name: s2-fS2; }
  .s2-fL2 { --pennant: var(--msg-reply); animation-name: s2-fL2; }
  @keyframes s2-fS1 { 0%, 2.5% { --pennant: var(--msg-receive); } 3.5%, 48.5% { --pennant: var(--msg-ask); } 49.5%, 100% { --pennant: var(--msg-receive); } }
  @keyframes s2-fL1 { 0%, 39.5% { --pennant: var(--msg-reply); } 40.5%, 42.5% { --pennant: var(--msg-receive); } 43.5%, 100% { --pennant: var(--msg-reply); } }
  @keyframes s2-fS2 { 0%, 45.5% { --pennant: var(--msg-receive); } 46.5%, 91.5% { --pennant: var(--msg-ask); } 92.5%, 100% { --pennant: var(--msg-receive); } }
  @keyframes s2-fL2 { 0%, 82.5% { --pennant: var(--msg-reply); } 83.5%, 85.5% { --pennant: var(--msg-receive); } 86.5%, 100% { --pennant: var(--msg-reply); } }

  /* Asleep, then awake, 16s. No firewall: a sleeping device can't take
     messages, so it polls. Asks wait on the VM's pier; on waking the barge
     fetches them all, hands each to its agent, and stays home until the
     laptop sleeps again. */
  .s3 .dot, .s3 .held, .s3 .anim { animation-duration: 16s; }
  .s3-night { opacity: 1; animation-name: s3-night; }
  .s3-awake { opacity: 0; animation-name: s3-awake; }
  @keyframes s3-night { 0%, 36% { opacity: 1; } 42%, 95% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes s3-awake { 0%, 36% { opacity: 0; } 42%, 95% { opacity: 1; } 100% { opacity: 0; } }
  .s3-barge { animation-name: s3-barge; }
  @keyframes s3-barge {
    0%, 42% { transform: translateX(0); } 54%, 65% { transform: translateX(-322px); }
    77%, 100% { transform: translateX(0); }
  }
  .s3-p1, .s3-p2, .s3-p3 { opacity: 1; }
  .s3-p1 { animation-name: s3-p1; }
  .s3-p2 { animation-name: s3-p2; }
  .s3-p3 { animation-name: s3-p3; }
  @keyframes s3-p1 { 0%, 8.9% { opacity: 0; } 9%, 55.9% { opacity: 1; } 56%, 100% { opacity: 0; } }
  @keyframes s3-p2 { 0%, 18.9% { opacity: 0; } 19%, 58.9% { opacity: 1; } 59%, 100% { opacity: 0; } }
  @keyframes s3-p3 { 0%, 28.9% { opacity: 0; } 29%, 61.9% { opacity: 1; } 62%, 100% { opacity: 0; } }
  .s3-c1 { animation-name: s3-c1; }
  .s3-c2 { animation-name: s3-c2; }
  .s3-c3 { animation-name: s3-c3; }
  @keyframes s3-c1 { 0%, 58.4% { opacity: 0; } 58.5%, 76.9% { opacity: 1; } 77%, 100% { opacity: 0; } }
  @keyframes s3-c2 { 0%, 61.4% { opacity: 0; } 61.5%, 79.9% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes s3-c3 { 0%, 64.4% { opacity: 0; } 64.5%, 82.9% { opacity: 1; } 83%, 100% { opacity: 0; } }
  .s3-s1 { offset-path: path("M65 108 Q 140 50 214 194.5"); animation-name: s3-s1; }
  .s3-s2 { offset-path: path("M175 108 Q 210 70 232 194.5"); animation-name: s3-s2; }
  .s3-s3 { offset-path: path("M65 108 Q 160 30 250 194.5"); animation-name: s3-s3; }
  .s3-l1 { offset-path: path("M214 194.5 Q 256 160 298 194.5"); animation-name: s3-l1; }
  .s3-l2 { offset-path: path("M232 194.5 Q 271 160 310 194.5"); animation-name: s3-l2; }
  .s3-l3 { offset-path: path("M250 194.5 Q 286 160 322 194.5"); animation-name: s3-l3; }
  .s3-u1 { offset-path: path("M620 194.5 Q 630 140 595 108"); animation-name: s3-u1; }
  .s3-u2 { offset-path: path("M632 194.5 Q 695 170 705 108"); animation-name: s3-u2; }
  .s3-u3 { offset-path: path("M644 194.5 Q 705 175 705 108"); animation-name: s3-u3; }
  .s3-r1 { offset-path: path("M595 108 Q 330 -30 65 108"); animation-name: s3-r1; }
  @keyframes s3-s1 { 0%, 4% { offset-distance: 0%; opacity: 0; } 4.5% { opacity: 1; } 8.5% { opacity: 1; } 9%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-s2 { 0%, 14% { offset-distance: 0%; opacity: 0; } 14.5% { opacity: 1; } 18.5% { opacity: 1; } 19%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-s3 { 0%, 24% { offset-distance: 0%; opacity: 0; } 24.5% { opacity: 1; } 28.5% { opacity: 1; } 29%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-l1 { 0%, 56% { offset-distance: 0%; opacity: 0; } 56.3% { opacity: 1; } 58.2% { opacity: 1; } 58.5%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-l2 { 0%, 59% { offset-distance: 0%; opacity: 0; } 59.3% { opacity: 1; } 61.2% { opacity: 1; } 61.5%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-l3 { 0%, 62% { offset-distance: 0%; opacity: 0; } 62.3% { opacity: 1; } 64.2% { opacity: 1; } 64.5%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-u1 { 0%, 77% { offset-distance: 0%; opacity: 0; } 77.3% { opacity: 1; } 79.7% { opacity: 1; } 80%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-u2 { 0%, 80% { offset-distance: 0%; opacity: 0; } 80.3% { opacity: 1; } 82.7% { opacity: 1; } 83%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-u3 { 0%, 83% { offset-distance: 0%; opacity: 0; } 83.3% { opacity: 1; } 85.7% { opacity: 1; } 86%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes s3-r1 { 0%, 87% { offset-distance: 0%; opacity: 0; } 87.5% { opacity: 1; } 91.5% { opacity: 1; } 92%, 100% { offset-distance: 100%; opacity: 0; } }
  .s3-fS1 { --pennant: var(--msg-receive); animation-name: s3-fS1; }
  .s3-fS2 { --pennant: var(--msg-ask); }
