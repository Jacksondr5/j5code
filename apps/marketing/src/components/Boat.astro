---
/**
 * One paper boat. Status picks the pennant, matching the Fleet page's states;
 * tone picks the outline for canvas or navy backgrounds. Purely decorative.
 */
interface Props {
  captain?: boolean;
  status?: "running" | "waiting" | "settled" | "alarm" | "none";
  tone?: "light" | "dark";
  size?: number;
  class?: string;
  style?: string;
}

const {
  captain = false,
  status = "running",
  tone = "light",
  size = 48,
  class: className,
  style,
} = Astro.props;

const height = Math.round(size * (56 / 64));
---

<svg
  class:list={["boat", `boat--${tone}`, `boat--${status}`, captain && "boat--captain", className]}
  viewBox="0 -8 64 56"
  width={size}
  height={height}
  aria-hidden="true"
  focusable="false"
  style={style}
>
  <use href={captain ? "#j5-captain" : "#j5-boat"} />
</svg>

<style is:global>
  .boat {
    --ink: #12202f;
    --hull: #fbf7ee;
    --sail-l: #e5ddc8;
    --sail-r: #fbf7ee;
    --pennant: #2f7d5b;
    --pennant-fill: var(--pennant);
    display: block;
    overflow: visible;
    flex-shrink: 0;
  }

  .boat--dark {
    --ink: #dfe9ee;
    --hull: #f4efe4;
    --sail-l: #cfd9df;
    --sail-r: #f4efe4;
    --pennant: #6fcf9a;
  }

  .boat--waiting {
    --pennant: #c9a24d;
  }

  .boat--settled {
    --pennant: #8fa0ad;
    --pennant-fill: transparent;
  }

  .boat--alarm {
    --pennant: #c8442d;
  }

  .boat--dark.boat--alarm {
    --pennant: #e8836f;
  }

  .boat--none {
    --pennant: transparent;
    --pennant-fill: transparent;
  }
</style>
