---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

/**
 * The Welcome page as J5 Code shows it (onboarding/WelcomePage.tsx): Agents and Projects, with
 * no Phone section. Agents are checked one by one, as they are on a first run.
 */
---

<div class="app app--window welcome" data-vignette role="img" aria-label="The Welcome page: Claude and Codex found and ready, Cursor to turn on, and three projects to import">
  <h4 class="welcome__title">Welcome to J5 Code</h4>
  <p class="welcome__sub">Setting up <span>lighthouse</span>.</p>

  <div class="welcome__bands">
    <div class="welcome__band">
      <p class="welcome__label">Agents</p>
      <div>
        <div class="welcome__row">
          <span class="welcome__icon"><img src="/harnesses/claude-ai-icon.svg" alt="" width="18" height="18" /></span>
          <span class="welcome__name">Claude</span>
          <span class="flip welcome__state">
            <span class="t-muted seq-from" style="--at: 0.7s">Checking…</span>
            <span class="welcome__ready seq-to" style="--at: 0.7s"><Icon name="check" class="ico-35" />Ready</span>
          </span>
        </div>
        <div class="welcome__row">
          <span class="welcome__icon"><Mark name="openai" class="ico-45" /></span>
          <span class="welcome__name">Codex</span>
          <span class="flip welcome__state">
            <span class="t-muted seq-from" style="--at: 1.2s">Checking…</span>
            <span class="welcome__ready seq-to" style="--at: 1.2s"><Icon name="check" class="ico-35" />Ready</span>
          </span>
        </div>
        <div class="welcome__row">
          <span class="welcome__icon"><Mark name="cursor" class="ico-45" /></span>
          <span class="welcome__name">Cursor</span>
          <span class="btn-a btn-a--outline btn-a--xs welcome__state">Turn on</span>
        </div>
        <div class="welcome__row welcome__more">
          <span class="welcome__icon"><Icon name="plus" /></span>
          <span>Add more agents</span>
          <Icon name="chevron-down" class="welcome__state" />
        </div>
      </div>
    </div>

    <div class="welcome__band">
      <p class="welcome__label">Projects</p>
      <div class="welcome__row">
        <span class="welcome__icon"><span class="welcome__check"><Icon name="check" class="ico-3" /></span></span>
        <span class="welcome__project">
          <span class="welcome__name">Import 3 projects and their threads</span>
          <span class="welcome__from">From your Claude Code, Codex, and Pi history</span>
        </span>
        <span class="btn-a btn-a--ghost-muted btn-a--xs welcome__state">Review all 5<Icon name="chevron-down" /></span>
      </div>
    </div>
  </div>

  <div class="welcome__footer">
    <span class="btn-a btn-a--primary seq" style="--at: 1.7s">Import 3 projects and start</span>
  </div>
</div>

<style>
  .welcome { padding: 26px 24px 20px; }
  .welcome__title { font-size: 24px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.3; }
  .welcome__sub { margin-top: 6px; font-size: 14px; color: var(--a-muted-fg); }
  .welcome__sub span { color: var(--a-fg); }

  .welcome__bands {
    margin-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--a-border) 60%, transparent);
  }

  .welcome__band {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    column-gap: 24px;
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--a-border) 60%, transparent);
  }

  .welcome__label { font-size: 14px; line-height: 40px; color: var(--a-muted-fg); }

  .welcome__row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 4px 0;
  }

  .welcome__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--a-fg);
  }

  .welcome__more { color: var(--a-muted-fg); }
  .welcome__more .welcome__icon { color: var(--a-muted-fg); }
  .welcome__name { font-size: 14px; font-weight: 500; }
  .welcome__state { margin-left: auto; justify-items: end; font-size: 12px; }
  .welcome__ready {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    color: var(--a-success-fg);
  }

  .welcome__project { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .welcome__project + .welcome__state { flex-shrink: 0; }
  .welcome__from { font-size: 12px; color: var(--a-muted-fg); }

  .welcome__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--a-primary);
    color: #fff;
  }

  .welcome__footer { display: flex; justify-content: flex-end; margin-top: 16px; }

  @media (max-width: 520px) {
    .welcome { padding: 20px 14px 16px; }
    .welcome__band { grid-template-columns: 1fr; }
    .welcome__label { line-height: 28px; }
    .welcome__row { flex-wrap: wrap; row-gap: 4px; }
  }
</style>
