---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

/**
 * The release in one pass: an issue on the Issues page, the thread that takes it, and the pull
 * request tools as the timeline shows them (work-log rows, the thread's PR badge, the issue's
 * state glyph). Plays once when it comes into view; the markup alone is the finished state.
 */
const steps = [
  { icon: "git-pull-request-arrow", label: "Opened a pull request", at: 1.1 },
  { icon: "git-pull-request-arrow", label: "Read CI logs", at: 2.0 },
  { icon: "git-pull-request-arrow", label: "Re-ran CI", at: 2.8 },
  { icon: "git-pull-request-arrow", label: "Merged a pull request", at: 3.9 },
] as const;
---

<div class="app app--window story" data-vignette>
  <div class="story__list" aria-label="The Issues page">
    <div class="topbar-a"><span>Issues</span></div>
    <div class="story__rows">
      <div class="group-a">
        <Mark name="github" />
        GitHub <span>· github.com</span><span>· 2 projects</span>
      </div>
      <div class="issue-a" aria-selected="true">
        <span class="flip">
          <Icon name="circle-dot" class="t-open seq-from" style="--at: 4.3s" />
          <Icon name="circle-check" class="t-done seq-to" style="--at: 4.3s" />
        </span>
        <span class="issue-a__lines">
          <span class="issue-a__line1">
            <span class="issue-a__key">#412</span>
            <span class="issue-a__title truncate">Uploads over 2 GB time out</span>
          </span>
          <span class="issue-a__meta">
            <span class="avatar-a avatar-a--sm" style="--av: #3b8fae">m</span>
            <span class="truncate">mara</span>
            <span class="truncate">lighthouse/charts</span>
            <span class="badge-a badge-a--label" style="--label: #d73a4a">bug</span>
            <span class="issue-a__time tnum">2h ago</span>
          </span>
        </span>
      </div>
      <div class="issue-a">
        <Icon name="circle-dot" class="t-open" />
        <span class="issue-a__lines">
          <span class="issue-a__line1">
            <span class="issue-a__key">#409</span>
            <span class="issue-a__title truncate">Add a dry-run import flag</span>
          </span>
          <span class="issue-a__meta">
            <span class="avatar-a avatar-a--sm" style="--av: #a67f2a">j</span>
            <span class="truncate">jonas</span>
            <span class="truncate">lighthouse/charts</span>
            <span class="issue-a__time tnum">5h ago</span>
          </span>
        </span>
      </div>
      <div class="group-a story__group2">
        <Mark name="linear" />
        Linear <span>· linear.app</span><span>· 1 project</span>
      </div>
      <div class="issue-a">
        <Icon name="circle-dot" class="t-open" />
        <span class="issue-a__lines">
          <span class="issue-a__line1">
            <span class="issue-a__key">TID-88</span>
            <span class="issue-a__title truncate">Export drops the last row</span>
          </span>
          <span class="issue-a__meta">
            <span class="avatar-a avatar-a--sm" style="--av: #2f7d5b">i</span>
            <span class="truncate">ines</span>
            <span class="issue-a__time tnum">1d ago</span>
          </span>
        </span>
      </div>
    </div>
  </div>

  <div class="story__thread" aria-label="The thread working on issue 412">
    <div class="topbar-a">
      <span class="truncate">Fix the large upload timeout</span>
      <span class="story__badge seq" style="--at: 1.1s">
        <span class="flip">
          <Icon name="git-pull-request-arrow" class="ico-3 t-open seq-from" style="--at: 3.9s" />
          <Icon name="git-merge" class="ico-3 t-done seq-to" style="--at: 3.9s" />
        </span>
        <span class="tnum">418</span>
      </span>
    </div>
    <div class="story__timeline">
      <div class="bubble-a seq" style="--at: 0.3s">Fix #412 and open a pull request. Merge it when CI is green.</div>
      <div class="story__work">
        {
          steps.map((step) => (
            <div class="work-a seq" style={`--at: ${step.at}s`}>
              <Icon name={step.icon} />
              <span class="truncate">{step.label}</span>
              <Icon name="chevron-right" />
            </div>
          ))
        }
      </div>
      <p class="reply-a seq" style="--at: 4.7s">
        CI failed on a runner that lost its network, so I re-&#8288;ran it. #418 is merged, and #412 closed with it.
      </p>
    </div>
    <button type="button" class="btn-a btn-a--ghost-muted btn-a--xs story__replay" data-replay>
      <Icon name="refresh-cw" />Play again
    </button>
  </div>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 12fr);
  }

  .story__list {
    border-right: 1px solid var(--a-border);
    padding-bottom: 14px;
  }

  .story__rows { padding: 4px 8px 0; }
  .story__group2 { margin-top: 18px; }

  .story__thread {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .story__badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: auto;
    font-size: 12px;
    font-weight: 400;
    color: var(--a-muted-fg);
  }

  .story__timeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 6px 20px 16px;
  }

  /* Room for Play again, which is offered only where motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .story__timeline { padding-bottom: 44px; }
  }

  .story__work { display: flex; flex-direction: column; }

  /* "re-ran" stays whole, which could leave one word on the last line. */
  .story .reply-a { text-wrap: balance; }

  /* Only where the sequence can play: with the script running and motion allowed. */
  .story .story__replay {
    position: absolute;
    right: 12px;
    bottom: 10px;
    display: none;
  }

  :global(.wn-motion) .story .story__replay { display: inline-flex; }

  @media (max-width: 720px) {
    .story { grid-template-columns: 1fr; }
    .story__list { border-right: 0; border-bottom: 1px solid var(--a-border); padding-bottom: 8px; }
    .story .story__rows .story__group2,
    .story .story__rows .story__group2 + .issue-a { display: none; }
    .story__timeline { padding-inline: 14px; }
    .story .topbar-a { padding-inline: 14px; height: 44px; }
  }
</style>
