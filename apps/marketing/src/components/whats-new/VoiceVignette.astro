---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

/**
 * Settings → Voice → Transcribe with, its picker open, beside the composer's recording capsule
 * (settings/VoiceSettingsPanel.tsx, chat/VoiceInputPill.tsx). Choosing a destination closes the
 * picker and updates the setting; the waveform plays a few beats and rests.
 */
const bars = [0.35, 0.6, 0.9, 0.5, 0.75, 1, 0.55, 0.3, 0.7, 0.95, 0.6, 0.4, 0.8, 0.5, 0.65, 0.9, 0.45, 0.7, 0.35, 0.6, 0.85, 0.5, 0.3, 0.55];
---

<div class="voice" data-vignette data-voice>
  <div class="app app--window voice__settings">
    <div class="settings-a">
      <div class="settings-a__row">
        <div>
          <p class="settings-a__title" id="wn-voice-title">Transcribe with</p>
          <p class="settings-a__desc">Where your speech is turned into text.</p>
        </div>
        <button type="button" class="select-a voice__trigger" disabled aria-haspopup="listbox" aria-expanded="true" aria-labelledby="wn-voice-title wn-voice-value" data-list-trigger>
          <span class="voice__value" id="wn-voice-value" data-voice-value><Icon name="monitor" /><span>lighthouse</span></span>
          <Icon name="chevron-down" />
        </button>
      </div>
    </div>
  </div>

  <div class="voice__below">
    <div class="app app--window voice__composer" aria-hidden="true">
      <div class="composer-a">
        <span class="composer-a__draft">The export skips the last day of the month because</span>
        <span class="voice__pill">
          <span class="btn-a btn-a--ghost btn-a--pill"><Icon name="x" /></span>
          <span class="voice__dot"></span>
          <span class="voice__timer tnum">0:07</span>
          <span class="voice__wave">
            {bars.map((height, index) => <i style={`--h: ${height}; --n: ${index}`} />)}
          </span>
          <span class="btn-a btn-a--primary btn-a--pill"><Icon name="check" /></span>
        </span>
      </div>
    </div>

    <div class="app voice__float">
      <div class="popup-a seq" style="--at: 0.35s" role="listbox" aria-label="Transcribe with">
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="false" data-voice-option="Off">
          <Icon name="mic-off" />Off
        </button>
        <p class="voice__group">On an environment</p>
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="true" data-voice-option="lighthouse">
          <Icon name="monitor" />lighthouse
        </button>
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="false" data-voice-option="harbor">
          <Icon name="monitor" />harbor
        </button>
        <p class="voice__group">Cloud via harbor</p>
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="false" data-voice-option="OpenAI" data-voice-via="harbor">
          <Mark name="openai" />OpenAI
        </button>
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="false" data-voice-option="Grok Voice Transcribe" data-voice-via="harbor">
          <img src="/harnesses/grok-dark.svg" alt="" width="16" height="16" class="voice__grok" />Grok Voice Transcribe
        </button>
        <button type="button" class="option-a" role="option" tabindex="-1" aria-selected="false" data-voice-option="OpenRouter" data-voice-via="harbor">
          <Icon name="audio-lines" />OpenRouter
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .voice__settings { padding: 16px; }
  .voice__settings .voice__trigger { min-width: 0; max-width: min(288px, 100%); }
  .voice__value { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .voice__value :global(span) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .voice__value :global(.ico) { color: var(--a-muted-fg); }
  .voice__value :global(img) { filter: invert(1); opacity: 0.85; }
  .voice__value :global(small) { font-size: inherit; color: var(--a-muted-fg); }

  /* The open picker hangs from its trigger, out over the window's edge; the composer sits beside it. */
  .voice__below {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    align-items: end;
    gap: 20px;
    padding-right: 33px;
    margin-top: -26px;
  }

  .voice__float { position: relative; z-index: 1; background: none; }
  .voice__float .popup-a { transform-origin: 100% 0; }
  .voice__group { padding: 6px 8px; font-size: 12px; font-weight: 500; color: var(--a-muted-fg); }
  .voice__float :global(.ico) { color: var(--a-muted-fg); }
  .voice__grok { filter: invert(1); opacity: 0.85; }

  .voice__composer { padding: 12px; }
  .voice__composer .composer-a { flex-wrap: wrap; row-gap: 10px; }
  .voice__composer .composer-a__draft { flex-basis: 100%; }

  .voice__pill {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 2px;
    margin-left: auto;
    border-radius: 999px;
    background: color-mix(in srgb, var(--a-muted-fg) 12%, transparent);
    box-shadow: inset 0 0 0 1px var(--a-border);
  }

  .voice__dot { width: 8px; height: 8px; border-radius: 999px; background: var(--a-destructive); }
  /* A shade deeper than the app's muted tone, which measures 4.2:1 on the capsule by day. */
  .voice__timer { font-size: 12px; color: color-mix(in srgb, var(--a-muted-fg) 75%, var(--a-fg)); }

  .voice__wave {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    width: 64px;
    height: 16px;
    margin-right: 6px;
    overflow: hidden;
  }

  .voice__wave i {
    width: 2px;
    height: 100%;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--a-fg);
    opacity: 0.35;
    scale: 1 var(--h);
  }

  /* Four beats, then the bars rest at their drawn heights. */
  :global(.wn-motion [data-play]) .voice__wave i {
    animation: wn-beat 0.7s ease-in-out calc(var(--n) * 35ms) 4 alternate;
  }

  @media (prefers-color-scheme: dark) {
    .voice__grok,
    .voice__value :global(img) { filter: none; }
  }

  @media (max-width: 640px) {
    .voice__settings { padding: 12px 10px; }
    .voice__settings :global(.settings-a__row) { grid-template-columns: 1fr; gap: 10px; }
    .voice__settings .voice__trigger { justify-self: stretch; max-width: none; }
    .voice__below {
      grid-template-columns: 1fr;
      padding-right: 0;
      margin-top: 8px;
      gap: 10px;
    }
    .voice__float { order: -1; justify-self: start; width: 232px; }
    /* Stacked, a closed list would leave a tall gap above the composer, so here it gives its place up. */
    .voice__float:has([data-closed]) { display: none; }
  }
</style>
