---
/**
 * Three vignettes playing at once across the hero: agents trading quick asks
 * and replies, a Captain leading its Crew around a circle, and an agent
 * spawning Peer Agents that spawn their own. Each loops on its own clock.
 * Everything is transform, opacity or offset only, gated by --motion-state
 * from lib/motion.ts.
 */
---

<div class="hs">
  <!-- Talking -->
  <figure class="hs-fig" data-motion>
    <svg viewBox="0 0 380 240" role="img" aria-label="Four agents exchanging asks and replies">
      <path class="hs-arc" d="M62 111 Q 110 40 190 31" />
      <path class="hs-arc" d="M318 111 Q 270 170 190 151" />
      <path class="hs-arc" d="M62 111 Q 190 -20 318 111" />
      <path class="hs-arc" d="M190 31 Q 235 91 190 151" />

      <g transform="translate(30 110)"><g class="bob" style="--bob-dur:4.6s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
      <g transform="translate(158 30)"><g class="bob" style="--bob-dur:5.2s;--bob-delay:-1.4s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
      <g transform="translate(286 110)"><g class="bob" style="--bob-dur:4.9s;--bob-delay:-2.8s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
      <g transform="translate(158 150)"><g class="bob" style="--bob-dur:5.5s;--bob-delay:-0.7s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g>

      <circle class="hs-dot hs-ask d1" r="4" />
      <circle class="hs-dot hs-reply d2" r="4" />
      <circle class="hs-dot hs-ask d3" r="4" />
      <circle class="hs-dot hs-reply d4" r="4" />
      <circle class="hs-dot hs-ask d5" r="4" />
      <circle class="hs-dot hs-reply d6" r="4" />
      <circle class="hs-dot hs-ask d7" r="4" />
    </svg>
    <figcaption>Any agent can message any agent</figcaption>
  </figure>

  <!-- Leading -->
  <figure class="hs-fig" data-motion>
    <svg viewBox="0 0 380 240" role="img" aria-label="A Captain leading three agents around a circle">
      <circle class="hs-ring" cx="190" cy="120" r="72" />
      <g class="orbit orbit--captain"><g transform="translate(-38 -37) scale(1.2)"><g class="bob" style="--bob-dur:5s"><use class="boat boat--dark" href="#j5-captain" /></g></g></g>
      <g class="orbit orbit--s1"><g transform="translate(-32 -30)"><g class="bob" style="--bob-dur:4.7s;--bob-delay:-1s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
      <g class="orbit orbit--s2"><g transform="translate(-32 -30)"><g class="bob" style="--bob-dur:5.3s;--bob-delay:-2s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
      <g class="orbit orbit--s3"><g transform="translate(-32 -30)"><g class="bob" style="--bob-dur:4.4s;--bob-delay:-3s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g></g>
    </svg>
    <figcaption>A Captain leads its Crew</figcaption>
  </figure>

  <!-- Spawning -->
  <figure class="hs-fig" data-motion>
    <svg viewBox="0 0 380 240" role="img" aria-label="An agent spawning Peer Agents, which spawn their own">
      <g transform="translate(152 64) scale(1.2)"><g class="bob" style="--bob-dur:5.4s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
      <g class="kids">
        <g class="sp sp-1"><g transform="translate(-32 -30)"><g class="bob" style="--bob-dur:4.8s;--bob-delay:-1s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
        <g class="sp sp-2"><g transform="translate(-32 -30)"><g class="bob" style="--bob-dur:5.1s;--bob-delay:-2s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
        <g class="sp sp-3"><g transform="translate(-26 -24) scale(0.82)"><g class="bob" style="--bob-dur:4.5s;--bob-delay:-0.5s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
        <g class="sp sp-4"><g transform="translate(-26 -24) scale(0.82)"><g class="bob" style="--bob-dur:5.6s;--bob-delay:-2.5s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g></g>
      </g>
    </svg>
    <figcaption>Agents spawn Peer Agents</figcaption>
  </figure>
</div>

<style>
  .hs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
  }

  .hs-fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hs-fig svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hs-fig figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--foam-dim);
  }

  .hs-arc,
  .hs-ring {
    fill: none;
    stroke: var(--foam);
    stroke-opacity: 0.22;
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  /* Talking: seven hops on an 8s loop, under a second each. */
  .hs-dot {
    opacity: 0;
    offset-rotate: 0deg;
    animation-duration: 8s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .hs-ask { fill: var(--sea); }
  .hs-reply { fill: var(--brass); }

  .d1 { offset-path: path("M62 111 Q 110 40 190 31"); animation-name: hop-1; }
  .d2 { offset-path: path("M190 31 Q 110 40 62 111"); animation-name: hop-2; }
  .d3 { offset-path: path("M318 111 Q 270 170 190 151"); animation-name: hop-3; }
  .d4 { offset-path: path("M190 151 Q 270 170 318 111"); animation-name: hop-4; }
  .d5 { offset-path: path("M62 111 Q 190 -20 318 111"); animation-name: hop-5; }
  .d6 { offset-path: path("M318 111 Q 190 -20 62 111"); animation-name: hop-6; }
  .d7 { offset-path: path("M190 31 Q 235 91 190 151"); animation-name: hop-7; }

  @keyframes hop-1 { 0%, 2% { offset-distance: 0%; opacity: 0; } 3% { opacity: 1; } 11% { opacity: 1; } 12%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-2 { 0%, 14% { offset-distance: 0%; opacity: 0; } 15% { opacity: 1; } 23% { opacity: 1; } 24%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-3 { 0%, 26% { offset-distance: 0%; opacity: 0; } 27% { opacity: 1; } 35% { opacity: 1; } 36%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-4 { 0%, 38% { offset-distance: 0%; opacity: 0; } 39% { opacity: 1; } 47% { opacity: 1; } 48%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-5 { 0%, 52% { offset-distance: 0%; opacity: 0; } 53% { opacity: 1; } 61% { opacity: 1; } 62%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-6 { 0%, 64% { offset-distance: 0%; opacity: 0; } 65% { opacity: 1; } 73% { opacity: 1; } 74%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-7 { 0%, 78% { offset-distance: 0%; opacity: 0; } 79% { opacity: 1; } 87% { opacity: 1; } 88%, 100% { offset-distance: 100%; opacity: 0; } }

  /* Leading: one lap every 14s. Each boat starts at its own point on the same
     circle, Captain in front. */
  .orbit {
    offset-rotate: 0deg;
    animation: lap 14s linear infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .orbit--captain { offset-path: path("M190 48 A 72 72 0 1 1 190 192 A 72 72 0 1 1 190 48"); }
  .orbit--s1 { offset-path: path("M145.7 63.3 A 72 72 0 1 1 234.3 176.7 A 72 72 0 1 1 145.7 63.3"); }
  .orbit--s2 { offset-path: path("M120.1 102.6 A 72 72 0 1 1 259.9 137.4 A 72 72 0 1 1 120.1 102.6"); }
  .orbit--s3 { offset-path: path("M124.2 149.3 A 72 72 0 1 1 255.8 90.7 A 72 72 0 1 1 124.2 149.3"); }

  @keyframes lap {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }

  /* Spawning: children pop out of the parent, then spawn their own, then the
     brood fades so it can happen again. 10s loop. */
  .kids {
    animation: brood 10s ease-in-out infinite;
    animation-play-state: var(--motion-state, paused);
  }
  @keyframes brood {
    0%, 86% { opacity: 1; }
    94%, 100% { opacity: 0; }
  }

  .sp {
    transform-box: view-box;
    transform-origin: 0 0;
    animation-duration: 10s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .sp-1 { animation-name: sp-1; }
  .sp-2 { animation-name: sp-2; }
  .sp-3 { animation-name: sp-3; }
  .sp-4 { animation-name: sp-4; }

  @keyframes sp-1 { 0%, 12% { transform: translate(190px, 100px) scale(0); } 20%, 100% { transform: translate(100px, 140px) scale(1); } }
  @keyframes sp-2 { 0%, 16% { transform: translate(190px, 100px) scale(0); } 24%, 100% { transform: translate(280px, 140px) scale(1); } }
  @keyframes sp-3 { 0%, 44% { transform: translate(100px, 140px) scale(0); } 52%, 100% { transform: translate(40px, 185px) scale(1); } }
  @keyframes sp-4 { 0%, 50% { transform: translate(280px, 140px) scale(0); } 58%, 100% { transform: translate(340px, 185px) scale(1); } }

  @media (max-width: 1024px) {
    .hs {
      gap: 16px;
    }
  }

  @media (max-width: 820px) {
    .hs {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-dot, .orbit, .kids, .sp { animation: none; }
    .hs-dot { opacity: 0; }
    .sp-1 { transform: translate(100px, 140px); }
    .sp-2 { transform: translate(280px, 140px); }
    .sp-3 { transform: translate(40px, 185px); }
    .sp-4 { transform: translate(340px, 185px); }
  }
</style>
