---
/**
 * Three acts on one 27s clock. Act one: four agents trading quick asks and
 * replies. Act two: a Captain leads its Crew around a circle. Act three: an
 * agent spawns Peer Agents, which spawn their own. Each act fades in and out
 * as a group; everything inside is transform, opacity or offset only, and the
 * whole scene is gated by --motion-state from lib/motion.ts.
 */
---

<svg class="hs" viewBox="0 0 900 260" role="img" aria-label="Agents messaging each other, a Captain leading a Crew, and an agent spawning Peer Agents" data-motion>
  <!-- Act 1: talking -->
  <g class="act act-1">
    <path class="hs-arc" d="M175 151 Q 290 40 450 56" />
    <path class="hs-arc" d="M735 151 Q 640 235 450 196" />
    <path class="hs-arc" d="M175 151 Q 455 -50 735 151" />
    <path class="hs-arc" d="M450 56 Q 540 126 450 196" />

    <g transform="translate(140 150) scale(1.1)"><g class="bob" style="--bob-dur:4.6s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
    <g transform="translate(415 55) scale(1.1)"><g class="bob" style="--bob-dur:5.2s;--bob-delay:-1.4s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
    <g transform="translate(700 150) scale(1.1)"><g class="bob" style="--bob-dur:4.9s;--bob-delay:-2.8s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
    <g transform="translate(415 195) scale(1.1)"><g class="bob" style="--bob-dur:5.5s;--bob-delay:-0.7s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g>

    <circle class="hs-dot hs-ask d1" r="4.5" />
    <circle class="hs-dot hs-reply d2" r="4.5" />
    <circle class="hs-dot hs-ask d3" r="4.5" />
    <circle class="hs-dot hs-reply d4" r="4.5" />
    <circle class="hs-dot hs-ask d5" r="4.5" />
    <circle class="hs-dot hs-reply d6" r="4.5" />
    <circle class="hs-dot hs-ask d7" r="4.5" />

    <text class="hs-cap" x="450" y="250">Any agent can message any agent</text>
  </g>

  <!-- Act 2: a Captain leads its Crew -->
  <g class="act act-2">
    <circle class="hs-ring" cx="450" cy="135" r="78" />
    <g class="orbit orbit--captain"><g transform="translate(-42 -40) scale(1.3)"><g class="bob" style="--bob-dur:5s"><use class="boat boat--dark" href="#j5-captain" /></g></g></g>
    <g class="orbit orbit--s1"><g transform="translate(-35 -33) scale(1.1)"><g class="bob" style="--bob-dur:4.7s;--bob-delay:-1s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
    <g class="orbit orbit--s2"><g transform="translate(-35 -33) scale(1.1)"><g class="bob" style="--bob-dur:5.3s;--bob-delay:-2s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
    <g class="orbit orbit--s3"><g transform="translate(-35 -33) scale(1.1)"><g class="bob" style="--bob-dur:4.4s;--bob-delay:-3s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g></g>
    <text class="hs-cap" x="450" y="250">A Captain leads its Crew</text>
  </g>

  <!-- Act 3: spawning -->
  <g class="act act-3">
    <g transform="translate(408 90) scale(1.3)"><g class="bob" style="--bob-dur:5.4s"><use class="boat boat--dark" href="#j5-boat" /></g></g>
    <g class="sp sp-1"><g transform="translate(-35 -33) scale(1.1)"><g class="bob" style="--bob-dur:4.8s;--bob-delay:-1s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
    <g class="sp sp-2"><g transform="translate(-35 -33) scale(1.1)"><g class="bob" style="--bob-dur:5.1s;--bob-delay:-2s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
    <g class="sp sp-3"><g transform="translate(-29 -27) scale(0.9)"><g class="bob" style="--bob-dur:4.5s;--bob-delay:-0.5s"><use class="boat boat--dark" href="#j5-boat" /></g></g></g>
    <g class="sp sp-4"><g transform="translate(-29 -27) scale(0.9)"><g class="bob" style="--bob-dur:5.6s;--bob-delay:-2.5s"><use class="boat boat--dark boat--waiting" href="#j5-boat" /></g></g></g>
    <text class="hs-cap" x="450" y="250">Agents spawn Peer Agents</text>
  </g>
</svg>

<style>
  .hs {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    --clock: 27s;
  }

  .hs-arc {
    fill: none;
    stroke: var(--foam);
    stroke-opacity: 0.22;
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .hs-ring {
    fill: none;
    stroke: var(--foam);
    stroke-opacity: 0.22;
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .hs-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-anchor: middle;
    fill: var(--foam-dim);
  }

  .act {
    opacity: 0;
    animation-duration: var(--clock);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }

  .act-1 { animation-name: act-1; }
  .act-2 { animation-name: act-2; }
  .act-3 { animation-name: act-3; }

  @keyframes act-1 {
    0% { opacity: 0; }
    2%, 31.3% { opacity: 1; }
    33.3%, 100% { opacity: 0; }
  }
  @keyframes act-2 {
    0%, 33.3% { opacity: 0; }
    35.3%, 64.6% { opacity: 1; }
    66.6%, 100% { opacity: 0; }
  }
  @keyframes act-3 {
    0%, 66.6% { opacity: 0; }
    68.6%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* Act 1: quick hops, about a second each. */
  .hs-dot {
    opacity: 0;
    offset-rotate: 0deg;
    animation-duration: var(--clock);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .hs-ask { fill: var(--sea); }
  .hs-reply { fill: var(--brass); }

  .d1 { offset-path: path("M175 151 Q 290 40 450 56"); animation-name: hop-1; }
  .d2 { offset-path: path("M450 56 Q 290 40 175 151"); animation-name: hop-2; }
  .d3 { offset-path: path("M735 151 Q 640 235 450 196"); animation-name: hop-3; }
  .d4 { offset-path: path("M450 196 Q 640 235 735 151"); animation-name: hop-4; }
  .d5 { offset-path: path("M175 151 Q 455 -50 735 151"); animation-name: hop-5; }
  .d6 { offset-path: path("M735 151 Q 455 -50 175 151"); animation-name: hop-6; }
  .d7 { offset-path: path("M450 56 Q 540 126 450 196"); animation-name: hop-7; }

  @keyframes hop-1 { 0%, 3% { offset-distance: 0%; opacity: 0; } 3.5% { opacity: 1; } 6.5% { opacity: 1; } 7%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-2 { 0%, 8% { offset-distance: 0%; opacity: 0; } 8.5% { opacity: 1; } 11.5% { opacity: 1; } 12%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-3 { 0%, 13% { offset-distance: 0%; opacity: 0; } 13.5% { opacity: 1; } 16.5% { opacity: 1; } 17%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-4 { 0%, 18% { offset-distance: 0%; opacity: 0; } 18.5% { opacity: 1; } 21.5% { opacity: 1; } 22%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-5 { 0%, 22% { offset-distance: 0%; opacity: 0; } 22.5% { opacity: 1; } 25.5% { opacity: 1; } 26%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-6 { 0%, 27% { offset-distance: 0%; opacity: 0; } 27.5% { opacity: 1; } 30.5% { opacity: 1; } 31%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes hop-7 { 0%, 25% { offset-distance: 0%; opacity: 0; } 25.5% { opacity: 1; } 28.5% { opacity: 1; } 29%, 100% { offset-distance: 100%; opacity: 0; } }

  /* Act 2: one lap of the circle during the act. Each boat starts at its own
     point on the same circle, Captain in front. */
  .orbit {
    offset-rotate: 0deg;
    animation: lap var(--clock) linear infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .orbit--captain { offset-path: path("M450 57 A 78 78 0 1 1 450 213 A 78 78 0 1 1 450 57"); }
  .orbit--s1 { offset-path: path("M402 73.5 A 78 78 0 1 1 498 196.5 A 78 78 0 1 1 402 73.5"); }
  .orbit--s2 { offset-path: path("M374.3 116.1 A 78 78 0 1 1 525.7 153.9 A 78 78 0 1 1 374.3 116.1"); }
  .orbit--s3 { offset-path: path("M378.7 166.7 A 78 78 0 1 1 521.3 103.3 A 78 78 0 1 1 378.7 166.7"); }

  @keyframes lap {
    0%, 33.3% { offset-distance: 0%; }
    66.6%, 100% { offset-distance: 100%; }
  }

  /* Act 3: children pop out of their parent, then spawn their own. */
  .sp {
    transform-box: view-box;
    transform-origin: 0 0;
    animation-duration: var(--clock);
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .sp-1 { animation-name: sp-1; }
  .sp-2 { animation-name: sp-2; }
  .sp-3 { animation-name: sp-3; }
  .sp-4 { animation-name: sp-4; }

  @keyframes sp-1 { 0%, 71% { transform: translate(450px, 135px) scale(0); } 75%, 100% { transform: translate(315px, 172px) scale(1); } }
  @keyframes sp-2 { 0%, 73% { transform: translate(450px, 135px) scale(0); } 77%, 100% { transform: translate(585px, 172px) scale(1); } }
  @keyframes sp-3 { 0%, 83% { transform: translate(315px, 172px) scale(0); } 87%, 100% { transform: translate(225px, 205px) scale(1); } }
  @keyframes sp-4 { 0%, 85% { transform: translate(585px, 172px) scale(0); } 89%, 100% { transform: translate(675px, 205px) scale(1); } }

  @media (prefers-reduced-motion: reduce) {
    .act, .hs-dot, .orbit, .sp { animation: none; }
    .act-1, .act-3 { opacity: 0; }
    .act-2 { opacity: 1; }
  }
</style>
