---
import Layout from "../layouts/Layout.astro";
import Pennant from "../components/Pennant.astro";
import CopyCommand from "../components/CopyCommand.astro";
import Boat from "../components/Boat.astro";
import A2AScene from "../components/A2AScene.astro";
import PlaybookScene from "../components/PlaybookScene.astro";
import HorizonScene from "../components/HorizonScene.astro";
import HeroScene from "../components/HeroScene.astro";
import { readForkFacts } from "../lib/forkFacts";
import {
  FORK_DISCIPLINE_URL,
  GITHUB_RELEASES_URL,
  GITHUB_REPOSITORY_URL,
  NPX_COMMAND,
  PRODUCT_DOCS_URL,
  STATUS_HELP,
  T3_SITE_URL,
  UPSTREAM_REPOSITORY_URL,
  UPSTREAM_V2_PR_URL,
} from "../lib/site";

const fork = readForkFacts();

const harnesses = [
  { name: "Claude Code", icon: "/harnesses/claude-ai-icon.svg" },
  { name: "Codex", icon: "/harnesses/openai_dark.svg" },
  { name: "Cursor", icon: "/harnesses/cursor_light.svg" },
  { name: "Grok", icon: "/harnesses/grok-dark.svg" },
  { name: "OpenCode", icon: "/harnesses/opencode-dark.svg" },
  { name: "Antigravity", icon: "/harnesses/antigravity.png" },
];
---

<Layout>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero" id="hero">
    <svg class="hero-chart" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M-40 520C180 470 300 560 520 500S900 380 1120 440s260 40 380 0" />
        <path d="M-40 580C200 530 320 610 540 560S920 450 1140 500s240 50 360 20" opacity="0.7" />
        <path d="M-40 640C220 600 340 660 560 620S940 520 1160 560s220 60 340 40" opacity="0.5" />
        <path d="M-40 700C240 670 360 710 580 680S960 590 1180 620s200 70 320 60" opacity="0.3" />
        <path d="M-40 120C160 160 300 90 520 130S900 230 1120 180s260-60 380-20" opacity="0.45" />
        <path d="M-40 60C180 100 320 30 540 70S920 170 1140 120s240-70 360-40" opacity="0.25" />
      </g>
      <g class="hero-rose" transform="translate(1210 210)" fill="none" stroke="currentColor" stroke-width="1">
        <circle r="120" opacity="0.5" />
        <circle r="92" stroke-dasharray="2 6" opacity="0.6" />
        <circle r="6" fill="currentColor" stroke="none" opacity="0.7" />
        <path d="M0-120V-40M0 40v80M-120 0h80M40 0h80" opacity="0.6" />
        <path d="M0-72 14 0 0 72-14 0Z" fill="currentColor" opacity="0.25" stroke="none" />
        <path d="M-72 0 0-14 72 0 0 14Z" fill="currentColor" opacity="0.18" stroke="none" />
        <path d="M0-72 14 0H-14Z" fill="currentColor" opacity="0.4" stroke="none" />
      </g>
    </svg>

    <div class="container hero-inner">
      <h1 class="hero-title display">
        <span data-rise>Steer fleets of agents,</span><br /><span data-rise style="--d:90ms">not just a few chats</span>
      </h1>

      <p class="hero-sub" data-rise style="--d:260ms">
        We believe the next frontier of agentic work will come from giving your agents tools that
        help them work effectively in groups. We're building J5 Code to push the tooling further
        and explore this frontier.
      </p>

      <div class="hero-actions" data-rise style="--d:360ms">
        <div class="hero-buttons">
          <a id="download-btn" href={GITHUB_RELEASES_URL} class="btn btn-primary btn-lg">
            <svg class="dl-icon dl-icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
            <span class="dl-label" data-mac="Download for macOS" data-other="Releases on GitHub">Download for macOS</span>
          </a>
        </div>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          Source on GitHub<span aria-hidden="true"> &#8599;</span>
        </a>
      </div>

      <p class="hero-honest" data-rise style="--d:440ms">
        Early software, in daily use by its author. Expect rough edges.
      </p>

    </div>

    <div class="hero-teasers">
      <HeroScene />
    </div>
  </section>

  <!-- ── Foundation (rendered in T3 Code's own theme) ────────── -->
  <section id="foundation" class="sec-foundation" data-theme="t3">
    <div class="t3-grid" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Foundation</div>
        <h2>Built on T3 Code. Kept up to date.</h2>
        <p>
          Everything T3 Code does, J5 Code does: six agent harnesses on your own subscriptions,
          desktop, web and mobile clients, remote control over your tailnet, a checkpoint on every
          turn, and the one-button PR. J5 adds a layer above it and works hard not to fork the hull.
        </p>
      </div>

      <div class="foundation-grid">
        <div class="foundation-copy">
          <ul class="checklist">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>Bring your own subscription. No keys resold, no quota caps.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>Desktop, web, and mobile. Control a server from a phone.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>A strong commitment to performance and quality.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>Commit, push, and open a PR from one button.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>MIT licensed, both of us.</li>
          </ul>
          <!-- T3's own hero motion: marks enter once, drift while visible, lean toward the pointer. -->
          <div class="harness-float" aria-label="Supported agent harnesses" data-motion>
            {harnesses.map((h, i) => (
              <span class:list={["hf-mark", `hf-${i}`, h.name === "Antigravity" && "hf-antigravity"]} title={h.name}>
                <span class="hf-card"><img src={h.icon} alt={h.name} loading="lazy" decoding="async" /></span>
              </span>
            ))}
          </div>
          <p class="foundation-t3">
            Want normal T3 Code? It is excellent.
            <a href={T3_SITE_URL} target="_blank" rel="noopener noreferrer">Get it at t3.codes<span aria-hidden="true"> &#8599;</span></a>
          </p>
        </div>

        <div class="sync-card tile">
          <div class="sync-head">
            <span class="sync-title">How J5 stays in sync</span>
          </div>
          <dl class="sync-rows">
            <div class="sync-row">
              <dt>Upstream</dt>
              <dd>
                <a href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">pingdotgg/t3code</a>
                <span class="sync-dim"> · tracking the <a href={UPSTREAM_V2_PR_URL} target="_blank" rel="noopener noreferrer">V2 orchestration branch</a></span>
              </dd>
            </div>
            {fork && (
              <div class="sync-row">
                <dt>Latest upstream commit</dt>
                <dd>
                  <code>{fork.pin}</code>
                  {fork.pinSelectedOn && <span class="sync-dim"> · selected {fork.pinSelectedOn}</span>}
                </dd>
              </div>
            )}
            <div class="sync-row">
              <dt>Cadence</dt>
              <dd>We stay as up to date as we can, but these guys are shipping like crazy. Please be patient.</dd>
            </div>
            <div class="sync-row">
              <dt>Policy</dt>
              <dd>Read our <a href={FORK_DISCIPLINE_URL} target="_blank" rel="noopener noreferrer">FORK.md</a> to see how we're merging with T3 Code.</dd>
            </div>
          </dl>
          <p class="sync-foot">The commit on this card is read from FORK.md when the site builds.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The fleet layer ──────────────────────────────────────── -->
  <section id="fleet" class="sec-fleet">
    <!-- Just launched: three boats straddle the seam between the T3 hull and J5's water. -->
    <div class="launch" aria-hidden="true" data-motion>
      <Boat size={44} class="bob" style="--bob-dur:5.3s" />
      <Boat size={40} status="waiting" class="bob" style="--bob-dur:6.1s;--bob-delay:-2s" />
      <Boat size={46} class="bob" style="--bob-dur:5.6s;--bob-delay:-4s" />
    </div>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">The fleet layer</div>
        <h2 class="display">Organize the work. Let the agents talk. Read the state.</h2>
        <p>
          T3 Code is built around one agent at a time. J5 is built for the moment you have twelve,
          most of them not talking to you, and you still need to know who is waiting on whom.
        </p>
      </div>

      <div class="scene scene--a2a">
        <A2AScene />
        <p class="scene-caption">An ask travels mast to mast. The receiver owes a reply, and the platform knows it until the green one comes back.</p>
      </div>

      <div class="legend" aria-label="Status legend">
        {(["underway", "charted", "horizon"] as const).map((s) => (
          <span class="legend-item"><Pennant status={s} /><span class="legend-help">{STATUS_HELP[s]}</span></span>
        ))}
      </div>

      <div class="feature-grid">
        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="2.2"/><path d="M12 7.5V21M5 12h14M4 15c1.5 4 4.5 6 8 6s6.5-2 8-6M4 15l-1.5-1.5M20 15l1.5-1.5"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>Squadrons</h3>
          <p>
            The unit of work. A Squadron groups agents, their artifacts and PRs, and their
            communication ledger around one initiative. Many efforts can share a repository, and one
            effort can span several. A grouping, never a boundary: any agent can still reach any other.
          </p>
        </article>

        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3v18M4 4h12l-3 4 3 4H4"/><path d="M13 14h7l-2.5 3 2.5 3h-7"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>Crews and Captains</h3>
          <p>
            Ask an agent for a crew in ordinary chat. It proposes a roster with a reason per seat, you
            edit and approve at the gate, and the seats spawn as full Peer Agents under their Captain.
            Seats report how they finished. Crews stop and archive as a unit, and archive never destroys work.
          </p>
        </article>

        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h11l-3-3M21 16H10l3 3"/><circle cx="19" cy="8" r="1.6"/><circle cx="5" cy="16" r="1.6"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>Agent-to-agent messaging</h3>
          <p>
            Durable, measured, legible. Every message lands in an append-only ledger. An ask opens an
            Exchange, so the platform can say who owes whom an answer, about what, and for how long.
            When a turn ends without the reply it owed, the platform records the silence. Scheduled
            scripts send in as registered machine participants.
          </p>
        </article>

        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l2.5-7h13L21 13v6H3z"/><path d="M3 13h5l1.5 3h5L16 13h5"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>The Inbox</h3>
          <p>
            Only asks that need you, from every Squadron on every connected server. Your answer,
            exactly as written, is the reply that closes the Exchange and reaches the agent. No relay,
            no summary. The count on the bell means exactly "things waiting on me."
          </p>
        </article>

        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 0-3 3z"/><path d="M5 4v16a3 3 0 0 1 3-3h11"/><path d="M9 9h6M9 12.5h4"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>Roles</h3>
          <p>
            Reusable, user-authored agent definitions in plain YAML: purpose, instructions, model route
            and fallbacks. Portable and shareable, git optional. Import a folder or write one in
            Settings. Every launch pins the definition it started with.
          </p>
        </article>

        <article class="feature">
          <div class="feature-top">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5" stroke-dasharray="2 2.5"/><path d="M12 12l6-6"/><circle cx="16" cy="14.5" r="1.3" fill="currentColor"/></svg>
            <Pennant status="underway" />
          </div>
          <h3>The Fleet page</h3>
          <p>
            Every agent in a Squadron with facts the platform measured: running or not, who it is
            waiting on, when it last did anything, and whether something broke. Active, settled, and
            retired, with each Crew under its Captain. An unknown renders as unknown.
          </p>
        </article>

        <article class="feature feature--wide">
          <div class="feature-wide-copy">
            <div class="feature-top">
              <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18c3-6 6 2 9-4s4-6 7-8"/><circle cx="4" cy="18" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="20" cy="6" r="1.6" fill="currentColor"/></svg>
              <Pennant status="charted" />
            </div>
            <h3>Playbooks</h3>
            <p>
              Step-by-step content a Role or Crew follows. An agent declares a step complete through
              a tool call, the platform delivers the next step's instructions fresh into every seat's
              context, and the Fleet page shows which step each Crew is on. Long procedures stop
              decaying into the back pages of context. Linear first, no platform-owned branching.
            </p>
          </div>
          <div class="pb-side" data-motion>
            <PlaybookScene />
            <ol class="steps" aria-label="Example Playbook">
              <span class="steps-marker" aria-hidden="true"></span>
              <li class="step"><span class="step-n">1</span><span>Build and test</span><span class="step-who">Builder</span></li>
              <li class="step"><span class="step-n">2</span><span>Independent review</span><span class="step-who">Critic</span></li>
              <li class="step"><span class="step-n">3</span><span>Sit on CI, triage failures</span><span class="step-who">Sitter</span></li>
              <li class="step"><span class="step-n">4</span><span>Is the migration safe to run?</span><span class="step-who">Captain</span></li>
              <li class="step"><span class="step-n">5</span><span>Merge and report</span><span class="step-who">Sitter</span></li>
            </ol>
          </div>
        </article>
      </div>

      <p class="fleet-docs">
        Every card above has a definition of record, with acceptance criteria, in the
        <a href={PRODUCT_DOCS_URL} target="_blank" rel="noopener noreferrer">product docs<span aria-hidden="true"> &#8599;</span></a>.
      </p>
    </div>
  </section>

  <!-- ── Standing orders ──────────────────────────────────────── -->
  <section class="sec-orders" aria-labelledby="orders-title" data-motion>
    <div class="container orders-inner">
      <span class="orders-boat" aria-hidden="true"><Boat tone="dark" size={52} class="bob" style="--bob-dur:6s" /></span>
      <h2 id="orders-title" class="eyebrow orders-eyebrow">Standing orders</h2>
      <ul class="orders">
        <li><span class="order-n">I</span><span>The platform delivers facts, never judgment.</span></li>
        <li><span class="order-n">II</span><span>Status is read, never asked.</span></li>
        <li><span class="order-n">III</span><span>Nothing vanishes silently.</span></li>
        <li><span class="order-n">IV</span><span>The hierarchy carries decisions, never messages.</span></li>
      </ul>
    </div>
  </section>

  <!-- ── Over the horizon ─────────────────────────────────────── -->
  <section id="horizon" class="sec-horizon">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Over the horizon</div>
        <h2 class="display">One person, many servers. Then many people.</h2>
        <p>
          The architecture was drawn for more than one machine and more than one person from the
          first day, so nothing here needs a rewrite. Here is what is sailing and what is still on the chart.
        </p>
      </div>

      <div class="horizon-grid">
        <article class="horizon-col">
          <Pennant status="underway" />
          <h3>Multi-server</h3>
          <p>Your work server and your home server, one inbox.</p>
          <ul>
            <li>Servers peer pairwise. Exchanges cross between them, and the receiving server writes its own record.</li>
            <li>Authority never replicates, so there is no sync to break. Views merge in the client.</li>
            <li>An unreachable server shows its last-known state with a staleness clock, never as fine.</li>
          </ul>
        </article>

        <article class="horizon-col">
          <span class="pennant-pair"><Pennant status="underway" /><span class="pennant-then">then</span><Pennant status="charted" /></span>
          <h3>Multi-agent collaboration</h3>
          <p>Crews and agent-to-agent messaging are live. Next up:</p>
          <ul>
            <li>Playbooks, so long procedures survive context decay and progress is a read.</li>
            <li>Memos, so an agent's "let's talk about that later" is not lost with its context.</li>
            <li>Cost per Squadron on the Fleet page, with the agents beneath it.</li>
          </ul>
        </article>

        <article class="horizon-col">
          <Pennant status="charted" />
          <h3>Multi-person</h3>
          <p>Shared Squadrons: several people, one server, the same agents.</p>
          <ul>
            <li>A support team hands a Squadron from one shift to the next with no context transfer.</li>
            <li>Two developers stand in front of the same agent instead of relaying its output over chat.</li>
            <li>Every ledger row already carries a person id, so nothing assumes there is exactly one of you.</li>
          </ul>
        </article>
      </div>
    </div>
    <div class="horizon-scene" aria-hidden="true">
      <HorizonScene />
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────── -->
  <section id="download" class="sec-cta" data-motion>
    <div class="container cta-inner">
      <span class="cta-boat" aria-hidden="true">
        <Boat captain tone="dark" size={112} class="bob" style="--bob-dur:6.4s" />
        <svg class="cta-wake" viewBox="0 0 160 12" aria-hidden="true"><path d="M0 6 Q 20 0 40 6 T 80 6 T 120 6 T 160 6" /></svg>
      </span>
      <h2 class="display cta-title">Take the helm.</h2>
      <p class="cta-sub">
        Free, MIT licensed, and a tracking fork of T3 Code. Bring the subscriptions you already have.
      </p>
      <div class="cta-actions">
        <a id="cta-download-btn" class="btn btn-primary btn-lg" href={GITHUB_RELEASES_URL}>
          <svg class="dl-icon dl-icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span class="dl-label" data-mac="Download for macOS" data-other="Releases on GitHub">Download for macOS</span>
        </a>
        <CopyCommand command={NPX_COMMAND} />
      </div>
      <p class="cta-note">
        Apple Silicon build today. Everything else runs the server with npx and opens the web app.
        <a href="/download">All download options</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  import { detectPlatform, fetchLatestRelease, pickMacAsset, RELEASES_URL } from "../lib/releases";
  import { startMotion } from "../lib/motion";

  startMotion({ scenes: Array.from(document.querySelectorAll<HTMLElement>("[data-motion]")) });
  const foundation = document.getElementById("foundation");
  const harnessField = document.querySelector<HTMLElement>(".harness-float");
  if (foundation && harnessField) {
    startMotion({ scenes: [], parallax: { area: foundation, field: harnessField } });
  }

  const platform = detectPlatform();
  if (platform) document.documentElement.dataset.platform = platform;

  const buttons = [
    document.getElementById("download-btn"),
    document.getElementById("cta-download-btn"),
  ].filter((el): el is HTMLAnchorElement => el instanceof HTMLAnchorElement);

  for (const btn of buttons) {
    const label = btn.querySelector<HTMLElement>(".dl-label");
    if (label) label.textContent = (platform === "mac" ? label.dataset.mac : label.dataset.other) ?? "";
  }

  async function init() {
    if (platform !== "mac") return;
    try {
      const release = await fetchLatestRelease();
      const url = pickMacAsset(release.assets ?? []) ?? RELEASES_URL;
      for (const btn of buttons) btn.href = url;
    } catch {
      for (const btn of buttons) btn.href = RELEASES_URL;
    }
  }

  init();
</script>

<style>
  /* ── Section base ─────────────────────────────────────────── */
  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }

  .section-head {
    margin-bottom: 52px;
    max-width: 760px;
  }

  .section-head .eyebrow {
    margin-bottom: 14px;
    display: block;
  }

  .section-head h2 {
