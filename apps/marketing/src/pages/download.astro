---
import Layout from "../layouts/Layout.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { RELEASES_URL } from "../lib/releases";
import { NPX_COMMAND, NPM_PACKAGE_URL } from "../lib/site";
---

<Layout title="Download — J5 Code" description="Download J5 Code for Apple Silicon Macs, or run the server anywhere with npx.">
  <div class="download-page">
    <h1 class="heading display">Download J5 Code</h1>
    <p class="subheading">
      <span id="version-label">Loading latest release&hellip;</span>
      <a id="changelog-link" class="inline-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none">Release notes<span aria-hidden="true"> &#8599;</span></a>
    </p>

    <div class="platforms">
      <section class="platform-section">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <h2 class="platform-name">macOS</h2>
        </div>
        <div class="download-cards">
          <a class="download-card" data-asset="arm64.dmg" href={RELEASES_URL}>
            <span class="card-arch">Apple Silicon</span>
            <span class="card-format">.dmg</span>
          </a>
        </div>
        <p class="note">
          Intel Macs are not packaged yet. Run the server with the command below instead.
        </p>
      </section>

      <section class="platform-section">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-5-6-5" /><path d="M12 19h8" /></svg>
          <h2 class="platform-name">Any machine with Node</h2>
        </div>
        <p class="note note-lead">
          Windows, Linux, Intel Macs, or a remote box on your tailnet. The command starts the J5 server and the local web app.
          Needs Node.js 22.16 or newer.
        </p>
        <CopyCommand command={NPX_COMMAND} />
        <p class="note">
          Add <code>--help</code> for the CLI reference. Package on <a class="inline-link" href={NPM_PACKAGE_URL} target="_blank" rel="noopener noreferrer">npm</a>.
        </p>
      </section>
    </div>

    <p class="releases-link">
      Every build, including nightlies, is on the
      <a class="inline-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">GitHub releases page<span aria-hidden="true"> &#8599;</span></a>.
    </p>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, pickMacAsset, RELEASES_URL } from "../lib/releases";

  async function init() {
    const versionLabel = document.getElementById("version-label");
    const cards = document.querySelectorAll<HTMLAnchorElement>("a[data-asset]");

    try {
      const release = await fetchLatestRelease();

      if (versionLabel && release.tag_name) {
        versionLabel.textContent = `Latest (${release.tag_name})`;
      }

      const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement | null;
      if (changelogLink && release.html_url) {
        changelogLink.href = release.html_url;
        changelogLink.style.display = "";
      }

      const mac = pickMacAsset(release.assets ?? []);
      cards.forEach((card) => {
        card.href = mac ?? RELEASES_URL;
      });
    } catch {
      if (versionLabel) versionLabel.textContent = "Could not load release info.";
      cards.forEach((card) => {
        card.href = RELEASES_URL;
      });
    }
  }

  init();
</script>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8vh 1.5rem 4rem;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(59, 143, 174, 0.14), transparent 70%),
      var(--navy-950);
  }

  .heading {
    font-size: clamp(2rem, 4.4vw, 3rem);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .subheading {
    font-size: 0.9rem;
    color: var(--foam-dim);
    margin-bottom: 3.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .inline-link {
    color: var(--foam-muted);
    text-decoration: underline;
    text-decoration-color: rgba(223, 233, 238, 0.3);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .inline-link:hover {
    color: var(--foam);
  }

  .platforms {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .platform-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--foam-muted);
    flex-shrink: 0;
  }

  .platform-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
  }

  .download-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: rgba(223, 233, 238, 0.03);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .download-card:hover {
    background: rgba(223, 233, 238, 0.07);
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .card-format {
    font-size: 0.8rem;
    color: var(--foam-dim);
  }

  .note {
    font-size: 0.82rem;
    color: var(--foam-dim);
    line-height: 1.55;
  }

  .note-lead {
    font-size: 0.9rem;
    color: var(--foam-muted);
  }

  .note code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--foam-muted);
  }

  .releases-link {
    margin-top: 3rem;
    font-size: 0.825rem;
    color: var(--foam-dim);
  }

  @media (max-width: 640px) {
    .download-page {
      padding: 5vh 1.25rem 4rem;
    }

    .download-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
