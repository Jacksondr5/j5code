---
import Layout from "../../layouts/Layout.astro";
import Boat from "../../components/Boat.astro";
import HeroStory from "../../components/whats-new/HeroStory.astro";
import UpstreamRoundup from "../../components/whats-new/UpstreamRoundup.astro";
import { ROUNDUP_CONTENTS, UPSTREAM_RANGE } from "../../components/whats-new/roundup";
import "../../components/whats-new/app.css";
import "../../components/whats-new/motion.css";
import "../../components/whats-new/page.css";

// The release this page describes. The file name and the highlights' learnMoreUrl carry it too.
const RELEASE = "0.0.54";
---

<Layout
  title={`What's new in ${RELEASE} — J5 Code`}
  description={`An Issues page for five trackers, agents that open, review and merge pull requests and read failing CI logs, the app in ten languages, and more from T3 Code ${UPSTREAM_RANGE}.`}
>
  <div class="wn" data-wn>
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="hero__tag" data-rise>
            <svg viewBox="0 0 14 10" aria-hidden="true"><path d="M0 0h14L9.5 5 14 10H0z"></path></svg>
            What's new in J5 Code {RELEASE}
          </p>
          <h1 class="display" data-rise style="--d: 80ms">
            Issues sit beside your threads. Agents take the pull request from open to merged.
          </h1>
          <p class="hero__lead" data-rise style="--d: 160ms">
            This release moves J5 Code onto T3 Code 0.1.11. It brings an Issues page for five trackers, agents that
            work the pull request and its CI, the app in ten languages, and a good deal more.
          </p>
        </div>
        <div class="hero__story" data-rise style="--d: 260ms">
          <HeroStory />
        </div>
      </div>
      <div class="hero__waterline" aria-hidden="true">
        <span class="hero__boat hero__boat--1"><Boat tone="dark" size={40} /></span>
        <span class="hero__boat hero__boat--2"><Boat captain tone="dark" size={54} /></span>
        <span class="hero__boat hero__boat--3"><Boat tone="dark" status="waiting" size={36} /></span>
        <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
          <path class="hero__wave" d="M0 22 Q 60 6 120 22 T 240 22 T 360 22 T 480 22 T 600 22 T 720 22 T 840 22 T 960 22 T 1080 22 T 1200 22 T 1320 22 T 1440 22 V48 H0 Z"></path>
          <path class="hero__crest" d="M0 22 Q 60 6 120 22 T 240 22 T 360 22 T 480 22 T 600 22 T 720 22 T 840 22 T 960 22 T 1080 22 T 1200 22 T 1320 22 T 1440 22" vector-effect="non-scaling-stroke"></path>
        </svg>
      </div>
    </section>

    <nav class="manifest" aria-labelledby="wn-manifest">
      <div class="container">
        <div class="sheet manifest__sheet">
        <div class="manifest__head">
          <h2 class="display" id="wn-manifest">In this release</h2>
          <p class="manifest__key">
            <span><svg class="pennant pennant--j5" viewBox="0 0 14 10" aria-hidden="true"><path d="M0 0h14L9.5 5 14 10H0z"></path></svg>J5 Code's own</span>
            <span><svg class="pennant pennant--t3" viewBox="0 0 14 10" aria-hidden="true"><path d="M0.6 0.6h12L8.7 5l3.9 4.4H0.6z"></path></svg>From T3 Code {UPSTREAM_RANGE}</span>
          </p>
        </div>
        <ol class="manifest__list">
          {
            ROUNDUP_CONTENTS.map((entry) => (
              <li>
                <a href={entry.href}>
                  <svg class:list={["pennant", `pennant--${entry.origin}`]} viewBox="0 0 14 10" role="img" aria-label={entry.origin === "j5" ? "J5 Code's own" : "From T3 Code"}>
                    <path d={entry.origin === "j5" ? "M0 0h14L9.5 5 14 10H0z" : "M0.6 0.6h12L8.7 5l3.9 4.4H0.6z"} />
                  </svg>
                  <span class="manifest__title">{entry.title}</span>
                  <span class="manifest__line">{entry.line}</span>
                </a>
              </li>
            ))
          }
        </ol>
        </div>
      </div>
    </nav>

    <UpstreamRoundup />
  </div>
</Layout>

<script>
  import { startWhatsNew } from "../../lib/whatsNew";
  import { startRoundup } from "../../lib/whatsNewRoundup";

  const root = document.querySelector<HTMLElement>("[data-wn]");
  if (root) {
    startWhatsNew(root);
    startRoundup(root);
  }
</script>

<style>
  /* Hero: the sea, with the release's story playing in a window of the app. */
  .hero {
    position: relative;
    padding: 72px 0 132px;
    background:
      radial-gradient(ellipse 60% 70% at 78% 30%, rgba(59, 143, 174, 0.2), transparent 70%),
      linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 100%);
    color: var(--foam);
    --wn-window-edge: rgba(223, 233, 238, 0.2);
    --wn-window-shadow: 0 40px 80px -36px rgba(0, 0, 0, 0.9);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 14fr);
    align-items: center;
    gap: 56px;
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--brass);
  }

  .hero__tag svg {
    width: 17px;
    height: 12px;
    fill: currentColor;
  }

  .hero h1 {
    font-size: clamp(32px, 3.5vw, 50px);
    line-height: 1.08;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 46ch;
    margin-top: 22px;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--foam-muted);
  }

  .hero__waterline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 48px;
    pointer-events: none;
  }

  .hero__waterline > svg {
    width: 100%;
    height: 100%;
  }

  .hero__wave {
    fill: var(--wn-bg);
  }

  /* At night the paper below is water too, so the crest is what the boats sit on. */
  .hero__crest {
    fill: none;
    stroke: none;
  }

  @media (prefers-color-scheme: dark) {
    .hero__crest {
      stroke: rgba(59, 143, 174, 0.7);
      stroke-width: 1.5;
    }
  }

  /* The wave crests every sixth of the width, from 1/24, and dips halfway between. Each boat is
     placed by its centre on a crest or in a trough, at that water's height, so it rides the wave. */
  .hero__boat {
    position: absolute;
    animation: wn-sail 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s backwards;
  }

  .hero__boat--1 { left: calc(12.5% - 20px); bottom: 13px; rotate: -1.5deg; }
  .hero__boat--2 { left: calc(20.833% - 27px); bottom: 29px; rotate: 1deg; animation-delay: 0.62s; }
  .hero__boat--3 { left: calc(29.167% - 18px); bottom: 13px; rotate: -1deg; animation-delay: 0.74s; }

  /* On a narrow page the waves are short, so each boat takes a crest of its own, a little deeper. */
  @media (max-width: 760px) {
    .hero__boat--1 { left: calc(20.833% - 20px); bottom: 24px; }
    .hero__boat--2 { left: calc(37.5% - 27px); bottom: 24px; }
    .hero__boat--3 { left: calc(54.167% - 18px); bottom: 24px; }
  }

  @keyframes wn-sail {
    from {
      opacity: 0;
      translate: -40px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__boat { animation: none; }
  }

  .manifest {
    padding: 56px 0 8px;
  }

  .manifest__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: 20px;
  }

  .manifest__head h2 { font-size: 26px; }

  .manifest__key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-size: 13px;
    color: var(--wn-muted);
  }

  .manifest__key span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .manifest__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    border-top: 1px solid var(--wn-line);
  }

  .manifest__list li {
    border-bottom: 1px solid var(--wn-line);
  }

  /* Carries the rule from the last entry across however many cells its row leaves empty. */
  .manifest__list {
    overflow-x: clip;
  }

  .manifest__list li:last-child {
    position: relative;
  }

  .manifest__list li:last-child::after {
    content: "";
    position: absolute;
    left: 100%;
    bottom: -1px;
    width: 100vw;
    border-bottom: 1px solid var(--wn-line);
  }

  .manifest__list a {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-content: start;
    gap: 3px 12px;
    height: 100%;
    padding: 14px 16px 16px 2px;
    transition: background-color 0.15s ease;
  }

  .manifest__list a:hover { background: var(--wn-tint); }
  .manifest__list .pennant { margin-top: 6px; transition: translate 0.2s ease; }
  .manifest__list a:hover .pennant { translate: 3px 0; }
  .manifest__title { font-size: 15px; font-weight: 600; line-height: 22px; }
  .manifest__line {
    grid-column: 2;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--wn-muted);
  }

  @media (max-width: 1000px) {
    .hero { padding-top: 48px; }
    .hero__inner { grid-template-columns: 1fr; gap: 36px; }
  }

  @media (max-width: 640px) {
    .hero { padding: 36px 0 104px; }
    .manifest { padding-top: 40px; }
  }
</style>
