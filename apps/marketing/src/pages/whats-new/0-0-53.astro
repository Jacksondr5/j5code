---
import Layout from "../../layouts/Layout.astro";
import Boat from "../../components/Boat.astro";
import InboxSection from "../../components/whats-new/InboxSection.astro";
import { INBOX_HEADING, INBOX_INTRO } from "../../components/whats-new/inbox";
import "../../components/whats-new/app.css";
import "../../components/whats-new/motion.css";
import "../../components/whats-new/page.css";

// The release this page describes. The file name and the highlights' learnMoreUrl carry it too.
const RELEASE = "0.0.53";
---

<Layout
  title={`What's new in ${RELEASE} — J5 Code`}
  description="Links in an agent's question open in that agent's panel beside the Inbox, and the reply box works like the composer."
>
  <div class="wn" data-wn>
    <section class="hero">
      <div class="container">
        <p class="hero__tag" data-rise>
          <svg viewBox="0 0 14 10" aria-hidden="true"><path d="M0 0h14L9.5 5 14 10H0z"></path></svg>
          What's new in J5 Code {RELEASE}
        </p>
        <h1 class="display" data-rise style="--d: 80ms">{INBOX_HEADING}</h1>
        <p class="hero__lead" data-rise style="--d: 160ms">{INBOX_INTRO}</p>
      </div>
      <div class="hero__waterline" aria-hidden="true">
        <span class="hero__boat hero__boat--1"><Boat tone="dark" size={40} /></span>
        <span class="hero__boat hero__boat--2"><Boat captain tone="dark" size={54} /></span>
        <span class="hero__boat hero__boat--3"><Boat tone="dark" status="waiting" size={36} /></span>
        <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
          <path class="hero__wave" d="M0 22 Q 60 6 120 22 T 240 22 T 360 22 T 480 22 T 600 22 T 720 22 T 840 22 T 960 22 T 1080 22 T 1200 22 T 1320 22 T 1440 22 V48 H0 Z"></path>
          <path class="hero__crest" d="M0 22 Q 60 6 120 22 T 240 22 T 360 22 T 480 22 T 600 22 T 720 22 T 840 22 T 960 22 T 1080 22 T 1200 22 T 1320 22 T 1440 22" vector-effect="non-scaling-stroke"></path>
        </svg>
      </div>
    </section>

    <InboxSection />
  </div>
</Layout>

<script>
  import { startWhatsNew } from "../../lib/whatsNew";

  const root = document.querySelector<HTMLElement>("[data-wn]");
  if (root) startWhatsNew(root);
</script>

<style>
  /* The hero is the sea in both schemes, with the fleet on the waterline. */
  .hero {
    position: relative;
    padding: 72px 0 132px;
    background:
      radial-gradient(ellipse 60% 70% at 78% 30%, rgba(59, 143, 174, 0.2), transparent 70%),
      linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 100%);
    color: var(--foam);
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--brass);
  }

  .hero__tag svg {
    width: 17px;
    height: 12px;
    fill: currentColor;
  }

  .hero h1 {
    max-width: 20ch;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.06;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 58ch;
    margin-top: 22px;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.6;
    color: var(--foam-muted);
  }

  .hero__waterline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 48px;
    pointer-events: none;
  }

  .hero__waterline > svg {
    width: 100%;
    height: 100%;
  }

  .hero__wave {
    fill: var(--wn-bg);
  }

  /* At night the paper below is water too, so the crest is what the boats sit on. */
  .hero__crest {
    fill: none;
    stroke: none;
  }

  @media (prefers-color-scheme: dark) {
    .hero__crest {
      stroke: rgba(59, 143, 174, 0.7);
      stroke-width: 1.5;
    }
  }

  /* The wave crests every sixth of the width, from 1/24, and dips halfway between. Each boat is
     placed by its centre on a crest or in a trough, at that water's height, so it rides the wave. */
  .hero__boat {
    position: absolute;
    animation: wn-sail 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s backwards;
  }

  .hero__boat--1 { left: calc(62.5% - 20px); bottom: 13px; rotate: -1.5deg; }
  .hero__boat--2 { left: calc(70.833% - 27px); bottom: 29px; rotate: 1deg; animation-delay: 0.62s; }
  .hero__boat--3 { left: calc(79.167% - 18px); bottom: 13px; rotate: -1deg; animation-delay: 0.74s; }

  /* On a narrow page the waves are short, so each boat takes a crest of its own, a little deeper. */
  @media (max-width: 760px) {
    .hero__boat--1 { left: calc(54.167% - 20px); bottom: 24px; }
    .hero__boat--2 { bottom: 24px; }
    .hero__boat--3 { left: calc(87.5% - 18px); bottom: 24px; }
  }

  @keyframes wn-sail {
    from {
      opacity: 0;
      translate: -40px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__boat { animation: none; }
  }

  .wn { padding-bottom: 96px; }
  /* The hero has already introduced the section that follows it. */
  .hero + :global(.feature) { padding-top: 56px; }

  @media (max-width: 1000px) {
    .hero { padding-top: 48px; }
  }

  @media (max-width: 640px) {
    .hero { padding: 36px 0 104px; }
  }
</style>
