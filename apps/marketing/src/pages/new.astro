---
import Layout from "../layouts/Layout.astro";
import Boat from "../components/Boat.astro";
import ServerForm from "../components/ServerForm.astro";
import "../styles/link-page.css";
---

<Layout title="Open a prompt — J5 Code" description="A prompt shared as a link. It opens in J5 Code as a draft, and nothing runs until you press Send.">
  <div class="link-page">
    <div class="heading-boat"><Boat tone="dark" size={56} /></div>

    <section class="panel" id="prompt-link" hidden>
      <h1 class="heading display">Open this prompt</h1>
      <p class="subheading">It opens as a draft in J5 Code. Nothing runs until you press Send.</p>

      <div class="warning" id="hidden-warning" role="alert" hidden>
        <strong>This prompt had hidden characters, it may be malicious</strong>
        <span id="hidden-count"></span>
      </div>

      <pre class="prompt" id="prompt-text"></pre>
      <p class="details" id="prompt-details"></p>

      <div class="actions">
        <a class="btn btn-primary" id="open-app" href="/download">Open in J5 Code</a>
        <a class="btn btn-ghost" href="/download">Get J5 Code</a>
      </div>

      <ServerForm label="Using J5 Code in a browser? Open the prompt on your server." />
    </section>

    <section class="panel" id="prompt-link-error" hidden>
      <h1 class="heading display">Could not open the link</h1>
      <p class="subheading" id="error-text"></p>
      <div class="actions">
        <a class="btn btn-ghost" href="/download">Get J5 Code</a>
      </div>
    </section>

    <noscript>
      <p class="subheading">This page needs JavaScript to read the prompt.</p>
    </noscript>
  </div>
</Layout>

<script>
  import { readPromptLinkPage } from "../lib/promptLink";
  import { wireServerForm } from "../lib/serverForm";

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const page = readPromptLinkPage(window.location.href);

  if (!page.ok) {
    byId("error-text").textContent = page.error;
    byId("prompt-link-error").hidden = false;
  } else {
    const { appPath, deepLink, prompt, details } = page.value;
    if (prompt !== null && prompt.hiddenCharacters > 0) {
      const count = prompt.hiddenCharacters;
      byId("hidden-count").textContent =
        `J5 Code removed ${count} hidden character${count === 1 ? "" : "s"}. Read the prompt before you send it.`;
      byId("hidden-warning").hidden = false;
    }
    const promptText = byId("prompt-text");
    if (prompt === null) promptText.hidden = true;
    else promptText.textContent = prompt.text;
    byId("prompt-details").textContent = details.join(" · ");
    byId<HTMLAnchorElement>("open-app").href = deepLink;

    wireServerForm(appPath);
    byId("prompt-link").hidden = false;
  }
</script>

<style>
  .warning {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid rgba(232, 131, 111, 0.55);
    background: rgba(200, 68, 45, 0.12);
    color: var(--foam);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .warning[hidden] {
    display: none;
  }

  .warning span {
    color: var(--foam-muted);
  }

  .prompt {
    align-self: stretch;
    max-height: 18rem;
    overflow: auto;
    padding: 1rem 1.1rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.18);
    color: var(--foam);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prompt[hidden] {
    display: none;
  }

  .details {
    align-self: stretch;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--foam-dim);
  }
</style>
