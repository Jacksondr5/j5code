J5_CONNECT_ISSUER=https://connect.example.com
POSTGRES_PASSWORD=
J5_CONNECT_PROVIDER=oidc
# Optional OIDC UserInfo lookup, including on refresh. Defaults to true.
# J5_CONNECT_OIDC_GET_USER_INFO=false
# Optional OIDC scope override, for example for a provider without email_verified.
# J5_CONNECT_OIDC_SCOPES="profile offline_access"
J5_CONNECT_UPSTREAM_ISSUER=https://login.example.com
J5_CONNECT_UPSTREAM_CLIENT_ID=
J5_CONNECT_UPSTREAM_CLIENT_SECRET=
# Replace each value. Single quotes preserve literal $ in Compose env files.
J5_CONNECT_CLIENTS='[{"id":"j5-server","name":"J5 server","secret":"replace-with-a-random-secret","redirectURIs":["https://server.example.com/api/j5/identity/callback"]}]'
